<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!-- A xunit v3 suite is a program that runs itself; dotnet test drives it
         through the testing platform rather than through VSTest. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The covers are decoded and re-encoded here, so the Linux natives are
         needed as they are in Koma.Imaging.Tests. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Koma.Library\Koma.Library.csproj" />
    <ProjectReference Include="..\Koma.TestSupport\Koma.TestSupport.csproj" />
  </ItemGroup>

</Project>

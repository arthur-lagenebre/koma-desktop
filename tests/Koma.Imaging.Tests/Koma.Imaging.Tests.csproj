<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- SkiaSharp itself comes through Koma.Imaging, which pins it. It carries
         the Windows natives; the Linux ones are a separate package, as in
         Avalonia.Skia's own dependencies. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Koma.Core\Koma.Core.csproj" />
    <ProjectReference Include="..\..\src\Koma.Imaging\Koma.Imaging.csproj" />
  </ItemGroup>

</Project>

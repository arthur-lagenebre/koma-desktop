<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!-- A xunit v3 suite is a program that runs itself; dotnet test drives it
         through the testing platform rather than through VSTest. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Koma.TestSupport\Koma.TestSupport.csproj" />
    <ProjectReference Include="..\..\src\Koma.Core\Koma.Core.csproj" />
  </ItemGroup>

</Project>
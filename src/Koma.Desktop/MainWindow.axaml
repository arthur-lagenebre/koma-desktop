<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Koma.Desktop"
        x:Class="Koma.Desktop.MainWindow"
        Title="KOMA"
        Width="1200"
        Height="800">
    <DockPanel>
        <StackPanel x:Name="TopBar" DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="8">
            <Button x:Name="LibraryButton" Content="Library" />
            <Button x:Name="ResumeButton" IsVisible="False" />
            <Button x:Name="AddFolderButton" Content="Add folder…" />
            <Button x:Name="ImportButton" Content="Import CBZ…" />
            <Button x:Name="EditButton" Content="Edit…" IsVisible="False" />
            <Button x:Name="OpenButton" Content="Open…" />
            <ToggleButton x:Name="ContentsButton" Content="Contents" IsVisible="False" />
            <ComboBox x:Name="FitChoice" IsVisible="False" SelectedIndex="0">
                <ComboBoxItem Content="Fit page" />
                <ComboBoxItem Content="Fit width" />
            </ComboBox>
            <TextBlock x:Name="SpreadCounter" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="8" TextWrapping="Wrap" />
        <DockPanel x:Name="NavigationPanel" DockPanel.Dock="Left" Width="280" IsVisible="False">
            <ListBox x:Name="LandmarkList" DockPanel.Dock="Bottom" MaxHeight="240" />
            <TreeView x:Name="Contents" />
        </DockPanel>
        <Panel x:Name="ViewHost">
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#2B2B2B">
                <local:SpreadView x:Name="View" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ScrollViewer>
            <local:LibraryView x:Name="Shelf" IsVisible="False" />
        </Panel>
    </DockPanel>
</Window>

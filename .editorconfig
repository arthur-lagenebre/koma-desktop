root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_require_accessibility_modifiers = always:warning
dotnet_diagnostic.CA1062.severity = warning

# Microsoft convention: var when the type is apparent on the right-hand side,
# explicit type otherwise.
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_var_for_built_in_types = false:suggestion

# Braces only where the body spans more than one line.
csharp_prefer_braces = when_multiline:suggestion

[*.{csproj,props,targets,xml,rnc,rng}]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Test projects are not a public API surface. The Subject_Behaviour naming
# convention is deliberate: it is what makes xUnit failure output readable.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1515.severity = none